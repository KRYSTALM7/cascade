# Copy to .env (git-ignored). Never commit real keys.

# rules  = deterministic offline parser/explainer (default; no key needed)
# gemini = Google Gemini via google-genai (requires GEMINI_API_KEY)
LLM_PROVIDER=rules
GEMINI_API_KEY=
# For API key rotation with automatic fallback on rate limits, add comma-separated keys:
# GEMINI_API_KEYS=key2,key3,key4
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.8-flash

# Used by `make dev-backend` / tests when running outside Docker.
DATABASE_URL=postgresql+psycopg://cascade:cascade@localhost:5432/cascade
TEST_DATABASE_URL=postgresql+psycopg://cascade:cascade@localhost:5432/cascade_test
LOG_JSON=false

# Demo controls. This file is for LOCAL / presenter use.
# DEMO_MODE=true enables demo identities, demo reset and the Escape Room.
DEMO_MODE=true
# PUBLIC_MODE: a visitor-facing instance refuses reset + Escape Room runs and hides the API docs.
# Unset = on when ENVIRONMENT=production, off locally. Never set PUBLIC_MODE=false on a shared URL.
# PUBLIC_MODE=
# Optional presenter token for reset/Escape Room on a public instance (header X-Demo-Admin-Token).
# DEMO_ADMIN_TOKEN=

# Gemini budget (only with LLM_PROVIDER=gemini): requests per process per window, then the
# deterministic rules provider answers. 0 = never call Gemini.
# LLM_CALL_LIMIT=200
# LLM_CALL_WINDOW_SECONDS=3600
